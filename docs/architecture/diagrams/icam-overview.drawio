<mxfile host="app.diagrams.net"><diagram id="icam-overview" name="Identity overview"><mxGraphModel dx="1600" dy="930" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="930" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="z_out" value='&lt;b&gt;OUTSIDE&lt;/b&gt;&lt;br&gt;&lt;font color="#5a6575"&gt;users, other participants&lt;/font&gt;' style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b7bec8;strokeWidth=1.5;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontColor=#5a6575;fontSize=12;fontFamily=Helvetica;container=0;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="250" height="780" as="geometry"/></mxCell><mxCell id="z_fap" value='&lt;b&gt;FAP DEPLOYMENT&lt;/b&gt;&lt;br&gt;&lt;font color="#5a6575"&gt;participant zone: the FAP IoT &amp;amp; AI components&lt;/font&gt;' style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f4faf4;strokeColor=#5b8a5e;strokeWidth=1.5;dashed=0;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontColor=#2e6b32;fontSize=12;fontFamily=Helvetica;container=0;" vertex="1" parent="1"><mxGeometry x="320" y="60" width="580" height="780" as="geometry"/></mxCell><mxCell id="z_fed" value='&lt;b&gt;FEDERATION TRUST SERVICES&lt;/b&gt;&lt;br&gt;&lt;font color="#5a6575"&gt;OCM W-Stack, wallets, policy&lt;/font&gt;' style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f6f8fb;strokeColor=#6c7c91;strokeWidth=1.5;dashed=0;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontColor=#34465f;fontSize=12;fontFamily=Helvetica;container=0;" vertex="1" parent="1"><mxGeometry x="930" y="60" width="650" height="630" as="geometry"/></mxCell><mxCell id="z_lake" value='&lt;b&gt;DATA LAKE&lt;/b&gt;&lt;br&gt;&lt;font color="#5a6575"&gt;Stackable: Trino, Kafka&lt;/font&gt;' style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#fbfbfc;strokeColor=#9aa5b3;strokeWidth=1.