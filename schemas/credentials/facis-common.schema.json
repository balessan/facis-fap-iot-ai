{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.facis.example/v1/facis-common.schema.json",
  "title": "FACIS shared claim vocabulary",
  "description": "Definitions shared by FacisParticipantCredential, FapIotAiRoleCredential and FapServiceCredential so that Keycloak and the policy agent read one claim vocabulary. Draft 0.2. The $id host is a placeholder until the schemas have a published location.",
  "$defs": {
    "did": {
      "type": "string",
      "pattern": "^did:(web|key):[A-Za-z0-9._%:-]+$",
      "description": "A DID. The FAP uses did:web for organisations and services; did:key is allowed for wallet holders."
    },
    "didWeb": {
      "type": "string",
      "pattern": "^did:web:[A-Za-z0-9.%-]+(:[A-Za-z0-9._%-]+)*$",
      "description": "A did:web DID."
    },
    "role": {
      "type": "string",
      "enum": ["data_engineer", "data_analyst", "data_scientist", "operator", "administrator"],
      "description": "Roles in the FAP IoT & AI. Used by people (FapIotAiRoleCredential) and machine clients (FapServiceCredential), so the policy agent and Keycloak see one vocabulary."
    },
    "roles": {
      "type": "array",
      "items": { "$ref": "#/$defs/role" },
      "minItems": 1,
      "uniqueItems": true
    },
    "purpose": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,48}$",
      "description": "A data-use purpose code. Starter vocabulary (see README): operations, analytics, research, ai_insight, maintenance."
    },
    "purposes": {
      "type": "array",
      "items": { "$ref": "#/$defs/purpose" },
      "minItems": 1,
      "uniqueItems": true
    },
    "credentialStatus": {
      "type": "object",
      "description": "Status entry allocated by the W-Stack statuslist-service. Both Bitstring and Token Status List shapes are accepted.",
      "oneOf": [
        {
          "properties": {
            "type": { "const": "BitstringStatusListEntry" },
            "statusPurpose": { "enum": ["revocation", "suspension"] },
            "statusListIndex": { "type": "string", "pattern": "^[0-9]+$" },
            "statusListCredential": { "type": "string", "format": "uri" }
          },
          "required": ["type", "statusPurpose", "statusListIndex", "statusListCredential"]
        },
        {
          "properties": {
            "status_list": {
              "type": "object",
              "properties": {
                "idx": { "type": "integer", "minimum": 0 },
                "uri": { "type": "string", "format": "uri" }
              },
              "required": ["idx", "uri"]
            }
          },
          "required": ["status_list"]
        }
      ]
    },
    "vcEnvelope": {
      "type": "object",
      "description": "The W3C VC data model wrapper as carried in the 'vc' claim of a jwt_vc_json credential. Accepts VCDM 1.1 (issuanceDate) and 2.0 (validFrom).",
      "properties": {
        "@context": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "type": {
          "type": "array",
          "items": { "type": "string" },
          "contains": { "const": "VerifiableCredential" }
        },
        "id": { "type": "string" },
        "issuer": {
          "oneOf": [
            { "$ref": "#/$defs/didWeb" },
            {
              "type": "object",
              "properties": { "id": { "$ref": "#/$defs/didWeb" } },
              "required": ["id"]
            }
          ]
        },
        "issuanceDate": { "type": "string", "format": "date-time" },
        "validFrom": { "type": "string", "format": "date-time" },
        "expirationDate": { "type": "string", "format": "date-time" },
        "validUntil": { "type": "string", "format": "date-time" },
        "credentialStatus": { "$ref": "#/$defs/credentialStatus" },
        "credentialSchema": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "type": { "const": "JsonSchema" }
          },
          "required": ["id", "type"]
        }
      },
      "required": ["@context", "type", "issuer", "credentialSubject", "credentialStatus"],
      "anyOf": [{ "required": ["issuanceDate"] }, { "required": ["validFrom"] }]
    }
  }
}
