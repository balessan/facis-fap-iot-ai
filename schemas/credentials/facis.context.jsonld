{
  "@context": {
    "@version": 1.1,
    "@protected": true,
    "facis": "https://schemas.facis.example/v1/vocab#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "FacisParticipantCredential": "facis:FacisParticipantCredential",
    "FapIotAiRoleCredential": "facis:FapIotAiRoleCredential",
    "FapServiceCredential": "facis:FapServiceCredential",
    "legalName": "https://schema.org/legalName",
    "name": "https://schema.org/name",
    "email": "https://schema.org/email",
    "participantRoles": { "@id": "facis:participantRoles", "@container": "@set" },
    "trustFramework": "facis:trustFramework",
    "dspEndpoint": { "@id": "facis:dspEndpoint", "@type": "@id" },
    "org_did": { "@id": "facis:organisation", "@type": "@id" },
    "roles": { "@id": "facis:roles", "@container": "@set" },
    "purposes": { "@id": "facis:purposes", "@container": "@set" },
    "serviceType": "facis:serviceType",
    "serviceName": "facis:serviceName"
  }
}
